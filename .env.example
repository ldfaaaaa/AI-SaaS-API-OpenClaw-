# 应用配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CORS配置
CORS_ORIGIN=*

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/ai_saas_db?schema=public

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 豆包API配置
DOUBAO_API_KEY=your-doubao-api-key-here
